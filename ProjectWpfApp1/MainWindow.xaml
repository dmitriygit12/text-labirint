<Window x:Class="ProjectWpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectWpfApp1"
        mc:Ignorable="d"
        Title="Текстовый квест" Height="480" Width="800"
        MinHeight="400" MinWidth="650">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2*" />

            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
                BorderBrush="LightGray" BorderThickness="1"
                Margin="0,0,10,10">
            <Grid>
                <Image x:Name="MyImage"
                       Source="/Images/room_1.jpg"
                       Stretch="Uniform"
                       Visibility="Visible" />

                <ListBox x:Name="MyListBox"
                         ItemsSource="{Binding Tasks}"
                         Visibility="Collapsed"
                         FontSize="14"
                         Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="4">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} — {1} ₽">
                                        <Binding Path="Title" />
                                        <Binding Path="Price" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
                BorderBrush="LightGray" BorderThickness="1"
                Margin="0,0,0,10" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="StatusTextBlock"
                           Text="-Начало игры-"
                           FontSize="16"
                           Foreground="Black"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <ListBox Grid.Row="1" Grid.Column="0"
                 x:Name="TasksListBox"
                 Margin="0,0,10,10"
                 SelectionChanged="TasksListBox_SelectionChanged"
                 MaxHeight="130">
            <ListBoxItem Content="Просмотр инвентаря" />
            <ListBoxItem Content="Закрыть" />
            <ListBoxItem Content="Пойти вверх" />
            <ListBoxItem Content="Пойти вниз" />
            <ListBoxItem Content="Пойти влево" />
            <ListBoxItem Content="Пойти вправо" />
        </ListBox>

        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="InputTextBox"
                     KeyDown="InputTextBox_KeyDown"
                     VerticalContentAlignment="Center"
                     Padding="5,0"
                     FontSize="14"
                     MinHeight="30" />

            <TextBlock Grid.Column="1"
                       Text="Enter ↵"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Foreground="Gray"
                       FontSize="12" />
        </Grid>

        <TextBlock Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                   Text="Введите команду и нажмите Enter.&#10;&#10;Доступно:&#10;• пойти вверх&#10;• пойти вниз&#10;• пойти влево&#10;• пойти вправо&#10;• инвентарь&#10;• закрыть"
                   FontSize="12"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0" />
    </Grid>
</Window>